# ================================================================
# NEXA AI ASSISTANT - Configuration Template
# ================================================================
# Copy this file to .env and customize for your setup
# 
# IMPORTANT: Do NOT share your .env file - it may contain API keys!
# ================================================================

# === AI Engine (Llama 3.1 8B via Ollama) ===
# Nexa uses local AI - no cloud API keys required for basic features!
# Install Ollama from: https://ollama.com
# Then run: ollama pull llama3.1:8b

# === Voice Recognition (Faster-Whisper) ===
# Automatically downloads on first run
WHISPER_MODEL_NAME=tiny.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8

# === Audio Settings ===
SAMPLE_RATE=16000
CHUNK_SIZE=1024
CHANNELS=1

# === Voice Output Settings ===
VOICE_SPEED=0.95
VOICE_PITCH=1.0

# === Application Settings ===
DEBUG_MODE=False
LOG_LEVEL=INFO

# === User Settings ===
# Your name for personalized greetings (set via voice on first run)
USER_NAME=

# ================================================================
# OPTIONAL FEATURES
# ================================================================

# === Weather Service (Optional) ===
# Get a FREE API key from: https://openweathermap.org/api
# Free tier: 1,000 calls/day, current weather + 5-day forecast
OPENWEATHERMAP_API_KEY=
WEATHER_DEFAULT_LOCATION=
WEATHER_CACHE_MINUTES=30

# === Speaker Verification (Optional - Disabled by Default) ===
# Voice authentication - only respond to your voice
SPEAKER_VERIFICATION_ENABLED=false
SPEAKER_VERIFICATION_GPU=true
SPEAKER_VERIFICATION_FP16=true
SPEAKER_SIMILARITY_THRESHOLD=0.85
SPEAKER_REJECT_UNKNOWN=true

# ================================================================
# ADVANCED SETTINGS (Usually not needed)
# ================================================================

# Custom Whisper model cache directory
# WHISPER_MODEL_CACHE_DIR=./models/whisper

# Speaker ID for multi-speaker TTS models
# SPEAKER_ID=0


